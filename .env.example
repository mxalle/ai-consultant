# Скопируйте в .env и заполните. .env в git не попадает.
# Один .env = один бизнес: свой бот, свой владелец, своя база знаний.

DEBUG=false

# --- бизнес -----------------------------------------------------------------
# Название, от имени которого говорит бот (приветствие и system prompt).
BUSINESS_NAME=Барбершоп «Кузня»
# Страница онлайн-записи (YCLIENTS, DIKIDI и т.п.). Её открывает кнопка
# «Записаться» под каждым ответом. Обязательно https://
BOOKING_URL=https://example.com/booking
# База знаний: обычный текст, читается при старте и целиком кладётся в промпт.
# Путь относительно корня проекта.
KNOWLEDGE_FILE=knowledge/demo_barbershop.md

# --- telegram ---------------------------------------------------------------
# Токен от @BotFather.
TELEGRAM_BOT_TOKEN=
# Куда бот пересылает вопросы, на которые не знает ответа. Свой id можно узнать
# у @userinfobot. Подойдёт и id группы (отрицательное число), куда добавлен бот.
# С этого чата бот общается как с владельцем, а не как с клиентом —
# проверяйте бота как клиент с другого аккаунта.
OWNER_CHAT_ID=
# Часовой пояс, в котором /stats считает «сегодня».
BOT_TIMEZONE=Europe/Moscow
# Сколько сообщений в час принимаем от одного клиента. Сверх — вежливый отказ
# без запроса к LLM.
RATE_LIMIT_PER_HOUR=30

# --- llm --------------------------------------------------------------------
# Любой OpenAI-совместимый API. Примеры:
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
#               LLM_MODEL=openai/gpt-4o-mini (или любая модель из каталога)
#   YandexGPT:  LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
#               LLM_MODEL=gpt://<folder_id>/yandexgpt/latest
#   GigaChat:   через OpenAI-совместимый прокси (например, gpt2giga)
# Точные значения сверяйте с документацией провайдера.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
# Сколько секунд ждём ответ модели, потом клиент получает текст-заглушку.
LLM_TIMEOUT=30

# --- база данных ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://consultant:consultant@localhost:5433/consultant

# --- docker-compose ---------------------------------------------------------
POSTGRES_USER=consultant
POSTGRES_PASSWORD=consultant
POSTGRES_DB=consultant
# 5433, чтобы не конфликтовать с другим postgres на 5432.
POSTGRES_PORT=5433
